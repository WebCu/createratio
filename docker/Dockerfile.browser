FROM node:24.22.3-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54

ARG PNPM_VERSION=12.11.2

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates unzip python3 python3-venv fonts-liberation fonts-dejavu-core \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 libcups2 libcurl4 \
    libdbus-1-3 libexpat1 libgbm1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 \
    libudev1 libvulkan1 libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 \
    libxkbcommon0 libxrandr2 \
  && rm -rf /var/lib/apt/lists/*

RUN npm install --global --no-fund --no-audit "pnpm@${PNPM_VERSION}"

ENV CREATERATIO_CACHE_DIR=/opt/createratio/cache
COPY bin/browser-pins.json bin/setup-chromium.js /opt/createratio/bin/
RUN node /opt/createratio/bin/setup-chromium.js \
  && python3 -m venv /opt/browser-harness \
  && /opt/browser-harness/bin/pip install --disable-pip-version-check --no-cache-dir \
    "browser-harness==$(node -p "require('/opt/createratio/bin/browser-pins.json').browserHarness")"

WORKDIR /opt/createratio/deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY extension/package.json extension/
COPY site/package.json site/
RUN pnpm install --frozen-lockfile --ignore-scripts

COPY docker/browser-check.sh /usr/local/bin/browser-check
ENV PATH=/opt/browser-harness/bin:$PATH \
  HOME=/tmp/home \
  CHROMIUM_NO_SANDBOX=1 \
  pnpm_config_verify_deps_before_run=false \
  BH_TELEMETRY=0 \
  BH_UPDATE_CHECK=0
USER node
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/browser-check"]
