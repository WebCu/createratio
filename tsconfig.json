{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2023",
    "module": "preserve",
    "lib": ["es2023", "dom", "dom.iterable"],
    "typeRoots": ["./node_modules/@types"],
    "types": ["chrome"],
    "skipLibCheck": true,
    "strict": false,
    "moduleDetection": "force"
  },
  "include": ["extension/types/*.d.ts", "extension/core/*.js", "extension/sites/*.js", "extension/src/**/*.js"],
  "exclude": ["**/*.test.js", "extension/sites/test-support.js", "extension/src/tests/**"]
}
